{
  "if": {
    "prefix": "bif",
    "body": ["@if ($${1:condition})", "    $0", "@endif"],
    "description": "Blade if statement"
  },
  "elseif": {
    "prefix": "bel",
    "body": ["@elseif ($${1:condition})"],
    "description": "Blade elseif"
  },
  "foreach": {
    "prefix": "bfe",
    "body": ["@foreach ($${1:items} as $${2:item})", "    $0", "@endforeach"],
    "description": "Blade foreach loop"
  },
  "for": {
    "prefix": "bfor",
    "body": [
      "@for ($${1:i} = 0; $${1:i} < $${2:count}; $${1:i}++)",
      "    $0",
      "@endfor"
    ],
    "description": "Blade for loop"
  },
  "section": {
    "prefix": "bsec",
    "body": ["@section('$${1:name}')", "    $0", "@endsection"],
    "description": "Blade section"
  },
  "extends": {
    "prefix": "bext",
    "body": ["@extends('$${1:layout}')"],
    "description": "Blade extends layout"
  },
  "include": {
    "prefix": "binc",
    "body": ["@include('$${1:view}')"],
    "description": "Blade include"
  }
}
